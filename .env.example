# Copy to .env and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# .env is gitignored. EXPO_PUBLIC_* values are inlined into the JS bundle at
# build time, so they ship inside the app — that is normal for Firebase client
# config. Protect data with Firestore/Storage Security Rules, not by hiding these.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web only — Firebase Analytics has no React Native implementation.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# AI Gündem bölümü. AYRI bir Supabase projesi — aşağıdaki panel bölümündeki
# SUPABASE_URL ile karıştırmayın, o görsel deposu ve sunucuda kalıyor.
#
# Boş bırakılırsa: geliştirmede fixture verisi, sürüm derlemesinde bölüm
# "yapılandırılmamış" diyor. Sürümde sessizce fixture GÖSTERMİYOR — uydurma
# haber başlıkları gerçek gibi görünürdü.
#
# mock | supabase. Boş = geliştirmede mock, sürümde supabase.
EXPO_PUBLIC_LEGAL_BASE_URL=
EXPO_PUBLIC_AIGUNDEM_DATA_MODE=
# https://<proje-ref>.supabase.co
EXPO_PUBLIC_AIGUNDEM_SUPABASE_URL=
# anon/publishable anahtar — tasarımı gereği herkese açık, koruma RLS'te.
# service_role anahtarı BURAYA GİRMEZ.
EXPO_PUBLIC_AIGUNDEM_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Sadece `npm run push` için — uygulamaya GİRMEZ, girmemeli.
#
# Admin SDK servis hesabı anahtarının yolu. Bu anahtar firestore.rules'u
# tamamen bypass eder: tüm veritabanını okur ve siler. EXPO_PUBLIC_ öneki
# YOKTUR ve olmamalıdır — o önek değeri JS paketine gömer.
#
# Firebase Console → Project settings → Service accounts → Generate new key
#
# Üç biçim de kabul ediliyor:
#   dosya yolu   ./service-account.json      (yerel; boş bırakılırsa varsayılan)
#   JSON         {"type":"service_account",…}
#   base64       base64 -i service-account.json | tr -d '\n'
#
# Sunucuda base64 olanı kullanın: PaaS'te diske dosya koymak ya mümkün değil ya
# da her deploy'da kayboluyor, ve private_key gerçek satır sonları taşıdığı için
# çok satırlı değer panolarda bozuluyor. base64 tek satır.
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Etkinlik görselleri — Supabase Storage. Sadece panel kullanıyor.
#
# Neden Firebase değil: Cloud Storage, 2024 sonrası açılan projelerde Blaze
# planı istiyor. Supabase ücretsiz katmanında 1 GB veriyor ve kart istemiyor.
# Firestore hâlâ Firebase'de; Supabase yalnızca dosyaları tutuyor.
#
# Dashboard → Project Settings → API
SUPABASE_URL=
# GİZLİ anahtar — `sb_secret_…` (eski sistemde `service_role` JWT'si, `eyJ…`).
# Dashboard → Project Settings → API Keys → Secret keys → Reveal.
#
# `sb_publishable_…` DEĞİL: o istemciye gömülmek için var, okuyabilir ama
# yazamaz; yükleme RLS'e takılır. Panel yanlış türü ilk istekten önce yakalayıp
# söylüyor.
#
# Firebase servis hesabı anahtarıyla aynı sınıfta: RLS'i tamamen aşar.
# EXPO_PUBLIC_ öneki YOKTUR ve olmamalıdır — o önek değeri uygulamanın JS
# paketine gömer ve herkese açar. Bu dosya değil, .env.local doldurulmalı.
SUPABASE_SERVICE_ROLE_KEY=
# Varsayılan: event-photos. Bucket "Public" olmalı, uygulama görselleri
# adresle çekiyor.
SUPABASE_STORAGE_BUCKET=

# Yönetim paneli (`npm run admin`) parolası. Panel kayıtlara erişiyor ve açık bir
# sunucuda çalışacak; tanımlı değilse panel başlamayı reddeder. Uzun ve rastgele
# olsun — tahmin edilirse bütün başvurular okunabilir hâle gelir.
ADMIN_PASSWORD=
# Varsayılan 4000.
ADMIN_PORT=
